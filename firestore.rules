// ─────────────────────────────────────────────────────────────
// firestore.rules — ยามเฝ้าข้อมูลของ LeaveEasy
//
// ⚠️ ยามเฝ้าตัวจริงอยู่ที่ไฟล์นี้ ไม่ใช่โค้ดในเบราว์เซอร์
//    การซ่อนปุ่มหรือเด้งหน้าใน js/auth.js แค่กันคนกดผิด ไม่ได้กันคนตั้งใจ
//    ใครก็เปิด Console ของเบราว์เซอร์แล้วยิงคำสั่งเข้าฐานตรง ๆ ได้
//    สิ่งที่หยุดเขาได้จริงคือกฎในไฟล์นี้เท่านั้น
//
// 📌 สัปดาห์ที่ 7 บังคับแค่ข้อเดียว — "ต้องล็อกอินก่อน ถึงอ่านหรือเขียนได้"
//    ยังไม่แยกว่าใครแตะของใครได้บ้าง เรื่องนั้นเป็นของสัปดาห์ที่ 8
//
// 🚀 วิธีเอาขึ้นใช้จริง (เลือกทางใดทางหนึ่ง)
//    ทางลัด : Firebase Console → Firestore Database → แท็บ Rules → วางทั้งไฟล์นี้ → Publish
//    ทาง CLI: firebase deploy --only firestore:rules
//
// ✅ วิธีตรวจว่ากฎทำงานจริง
//    ออกจากระบบ แล้วเปิด leave-requests.html — ต้องเด้งไปหน้าเข้าสู่ระบบ
//    และถึงยิงคำสั่งอ่านตรง ๆ จาก Console ก็ต้องได้ permission-denied
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── โฟลเดอร์ users ──
    // ตอนสมัครสมาชิก หน้าเว็บจะเขียนไฟล์ users/{uid} ทันทีหลังสร้างบัญชี
    // จังหวะนั้นถือว่าล็อกอินแล้ว จึงผ่านกฎข้อนี้
    match /users/{รหัสผู้ใช้} {
      allow read, write: if request.auth != null;
    }

    // ── โฟลเดอร์ leaveTypes ──
    match /leaveTypes/{รหัสประเภท} {
      allow read, write: if request.auth != null;
    }

    // ── โฟลเดอร์ leaveRequests ──
    match /leaveRequests/{รหัสใบลา} {
      allow read, write: if request.auth != null;

      // ── โฟลเดอร์ย่อย approvals ที่ซ้อนอยู่ในใบลาแต่ละใบ ──
      // ⚠️ กฎของไฟล์แม่ "ไม่ตกทอด" ลงมาถึงโฟลเดอร์ย่อยเอง ต้องเขียนครอบไว้เองเสมอ
      //    ถ้าลืมข้อนี้ ใบลาจะถูกกันไว้เรียบร้อย แต่ความเห็นข้างในเปิดอ่านได้หมด
      match /approvals/{รหัสความเห็น} {
        allow read, write: if request.auth != null;
      }
    }

    // โฟลเดอร์อื่นนอกจาก 4 ชื่อข้างบน ไม่มีกฎรองรับ = เข้าไม่ได้โดยปริยาย
    // ไม่ต้องเขียนกฎปฏิเสธเพิ่ม เพราะ Firestore ปิดทุกอย่างที่ไม่ได้เปิดไว้อยู่แล้ว
  }
}
