# ─────────────────────────────────────────────────────────────
# .gitignore ของโครงงาน LeaveEasy
#
# ไฟล์นี้คือ "รายชื่อสิ่งที่ห้ามส่งขึ้น GitHub"
#
# 📌 กันไว้ 2 กลุ่ม
#    1. ไฟล์ขยะที่เครื่องมือสร้างเอง
#    2. ไฟล์ตั้งค่าที่มีคีย์ลับ (สัปดาห์ที่ 7)
# ─────────────────────────────────────────────────────────────


# ── ชิ้นส่วนที่เครื่องมือติดตั้งให้ (ใหญ่มาก และสร้างใหม่ได้เสมอ) ──
node_modules/


# ── ไฟล์ที่เครื่องเราสร้างเอง ──
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/


# ═════════════════════════════════════════════════════════════
# 🔑 ไฟล์ที่มีคีย์ลับ — หลุดขึ้น GitHub แล้วแก้ทีหลังไม่ได้
# ═════════════════════════════════════════════════════════════

# ── กุญแจผีของ Firebase (Service Account) ──
# ไฟล์กลุ่มนี้ข้ามกฎความปลอดภัยได้ทั้งหมด ใครได้ไปคือเปิดฐานข้อมูลเราได้ทุกอย่าง
serviceAccountKey.json
service-account*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json


# ── ไฟล์ตั้งค่าที่เก็บค่าลับ ──
.env
.env.*
!.env.example
secrets.json
credentials.json
config.secret.js
*.secret.*


# ── กุญแจและใบรับรองทุกชนิด ──
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*


# ── ร่องรอยที่เครื่องมือ Firebase ทิ้งไว้ ──
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log


# ═════════════════════════════════════════════════════════════
# ✅ ไฟล์ตั้งค่า 3 ตัวนี้ "ต้อง" ส่งขึ้น GitHub ห้ามกัน
#
#    js/firebase-init.js   ค่า firebaseConfig ของเว็บ ไม่ใช่ความลับ
#                          ใครเปิดหน้าเว็บเราก็เห็นอยู่แล้ว
#                          สิ่งที่กันคนอื่นคือ Security Rules ไม่ใช่การซ่อนค่านี้
#    package.json          บอกว่าโครงงานนี้ต้องติดตั้งอะไรบ้าง
#    serve.json            ค่าตั้งของตัวเปิดเว็บตอนพัฒนา
# ═════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# ✅ วิธีตรวจว่าใช้ได้จริง — ก่อน push ทุกครั้ง พิมพ์บอก Claude ว่า
#
#     แสดงรายการไฟล์ที่กำลังจะส่งขึ้น GitHub ให้ผมดู
#
# แล้วอ่านรายชื่อที่มันแสดงมาด้วยตาตัวเอง
# ถ้าเห็น node_modules หรือไฟล์ที่มีคำว่า key / secret / credential
# แปลว่ายังกันไม่สำเร็จ — อย่าเพิ่ง push ให้เรียกผู้ช่วยก่อน
# ─────────────────────────────────────────────────────────────

# ── Playwright (สัปดาห์ที่ 9) ──
# ผลการรันเทสต์กับภาพหน้าจอตอนพัง — สร้างใหม่ได้ทุกครั้งที่รัน ไม่ต้องเก็บลง git
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# ภาพกับ snapshot ที่ Playwright MCP เขียนทิ้งไว้ตอน Claude สั่งเปิดเบราว์เซอร์
/.playwright-mcp/
